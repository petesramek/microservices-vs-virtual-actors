@using Workbench.Contracts
@using Workbench.Contracts.Orders
@using Workbench.Contracts.Scenarios

<article class="card result-card">
    <header class="result-card-header">
        <div>
            <span class="state-kicker">@Title</span>
            <h3>@GetOutcomeLabel()</h3>
        </div>
        <span class="status-badge @GetStatusClass()">@GetOutcomeLabel()</span>
    </header>

    <section class="metric-grid">
        <div class="metric">
            <span>Total request submissions</span>
            <strong>@TotalRequestSubmissions</strong>
        </div>

        <div class="metric">
            <span>Unique successful orders</span>
            <strong>@Result.CompletedOrders</strong>
        </div>

        <div class="metric">
            <span>Rejected submissions</span>
            <strong>@Result.RejectedOrders</strong>
        </div>

        <div class="metric">
            <span>Idempotent duplicate responses</span>
            <strong>@Result.IdempotentResponses</strong>
        </div>

        <div class="metric">
            <span>Remaining inventory</span>
            <strong>@Result.RemainingInventory</strong>
        </div>

        <div class="metric">
            <span>Elapsed</span>
            <strong>@Result.ElapsedMilliseconds ms</strong>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Result.Reason))
    {
        <p class="reason"><strong>Reason:</strong> @GetReasonLabel()</p>
    }

    @if (Result.Events.Count > 0)
    {
        <h4>Timeline</h4>
        <ol class="timeline">
            @foreach (var scenarioEvent in Result.Events)
            {
                <li>
                    <span>@scenarioEvent.Source</span>
                    <p>@scenarioEvent.Message)</p>
                </li>
            }
        </ol>
    }
</article>

@code {
    /// <summary>
    /// Gets or sets the architecture or result-set title displayed by the
    /// card.
    /// </summary>
    /// <value>The title rendered above the outcome label.</value>
    [Parameter]
    public required string Title { get; set; }

    /// <summary>
    /// Gets or sets the scenario execution result displayed by the card.
    /// </summary>
    /// <value>
    /// The execution outcome, metrics, reason, and timeline events to render.
    /// </value>
    [Parameter]
    public required ScenarioExecutionResult Result { get; set; }

    /// <summary>
    /// Gets the total number of request submissions represented by the result.
    /// </summary>
    /// <value>
    /// <see cref="ScenarioExecutionResult.TotalRequestSubmissions"/> when it is
    /// greater than zero; otherwise, the sum of completed orders, rejected
    /// orders, and idempotent responses.
    /// </value>
    private int TotalRequestSubmissions => Result.TotalRequestSubmissions > 0
        ? Result.TotalRequestSubmissions
        : Result.CompletedOrders + Result.RejectedOrders + Result.IdempotentResponses;

    /// <summary>
    /// Gets a value indicating whether the result contains both completed and
    /// rejected orders.
    /// </summary>
    /// <value>
    /// <see langword="true"/> when at least one order completed and at least
    /// one order was rejected; otherwise, <see langword="false"/>.
    /// </value>
    private bool HasMixedOutcome => Result.CompletedOrders > 0 && Result.RejectedOrders > 0;

    /// <summary>
    /// Gets the user-facing label for the execution outcome.
    /// </summary>
    /// <returns>
    /// <c>Partially fulfilled</c> for mixed outcomes, <c>Fulfilled</c> when at
    /// least one order completed, <c>Rejected</c> when at least one order was
    /// rejected, or the execution status name when no order counts are
    /// available.
    /// </returns>
    private string GetOutcomeLabel()
    {
        if (HasMixedOutcome)
        {
            return "Partially fulfilled";
        }

        if (Result.CompletedOrders > 0)
        {
            return "Fulfilled";
        }

        if (Result.RejectedOrders > 0)
        {
            return "Rejected";
        }

        return Result.Status.ToString();
    }

    /// <summary>
    /// Gets the CSS class associated with the execution outcome.
    /// </summary>
    /// <returns>
    /// The partial, completed, rejected, or neutral status class selected from
    /// the order counts and execution status.
    /// </returns>
    private string GetStatusClass()
    {
        if (HasMixedOutcome)
        {
            return "status-partial";
        }

        if (Result.CompletedOrders > 0)
        {
            return "status-completed";
        }

        if (Result.RejectedOrders > 0)
        {
            return "status-rejected";
        }

        return Result.Status switch
        {
            OrderStatus.Completed => "status-completed",
            OrderStatus.Rejected => "status-rejected",
            _ => "status-neutral"
        };
    }

    /// <summary>
    /// Gets the user-facing explanation for the execution result reason.
    /// </summary>
    /// <returns>
    /// A descriptive label for a recognized reason, an empty string when the
    /// reason is <see langword="null"/>, or the original reason when no mapping
    /// is defined.
    /// </returns>
    private string GetReasonLabel()
    {
        return Result.Reason switch
        {
            "SomeOrdersRejected" => "Stock was exhausted for some request submissions.",
            "IdempotentResultReturned" => "Duplicate request returned an existing order result.",
            null => string.Empty,
            _ => Result.Reason
        };
    }
}
