@page "/system-health"

@using Workbench.Ui.Components.Health.Fragments
@using global::Observability.Health
@using global::Observability.Topology.Definitions
@using global::Observability.Topology.Snapshots
@using Workbench.Ui.Observability.Health
@using Workbench.Ui.Observability.Topology

@inject SystemHealthService HealthService
@inject TopologyDefinitionProvider TopologyProvider

<PageTitle>System Health</PageTitle>

<HeadContent>
    <link rel="stylesheet" href="health.css" />
</HeadContent>

<section class="health-page"
         aria-labelledby="health-page-title">
    <header class="page-heading health-page-header">
        <h2 id="health-page-title">System Health</h2>
        <p>
            Review service availability, direct resource health,
            dependency health, and group health.
        </p>
    </header>

    <section class="system-health"
             aria-labelledby="health-page-title"
             aria-busy="@isLoading.ToString().ToLowerInvariant()">
        <header class="system-health-header">
            <div class="system-health-actions">
                @if (snapshot is not null) {
                    <span class="system-health-updated"
                          title="@FormatFullTimestamp(snapshot.GeneratedAtUtc)">
                        Updated @FormatTime(snapshot.GeneratedAtUtc)
                    </span>
                }

                <button type="button"
                        class="status-refresh"
                        @onclick="RefreshAsync"
                        disabled="@isLoading">
                    @(isLoading ? "Refreshing…" : "Refresh")
                </button>
            </div>
        </header>

        @if (isLoading && snapshot is null) {
            <HealthMessageCard CssClass="state-card running-state"
                               Role="status"
                               AriaLive="polite"
                               Title="Checking system health…"
                               Message="Collecting service, storage, and dependency observations." />
        } else if (!string.IsNullOrWhiteSpace(errorMessage) && snapshot is null) {
            <HealthMessageCard CssClass="status-error-card"
                               Role="alert"
                               Title="System health is unavailable."
                               Message="@errorMessage" />
        } else if (snapshot is null || snapshot.Nodes.Count == 0) {
            <HealthMessageCard CssClass="state-card empty-state"
                               Title="No health snapshot is available."
                               Message="Refresh to inspect the current system state." />
        } else {
            if (!string.IsNullOrWhiteSpace(errorMessage)) {
                <HealthMessageCard CssClass="status-error-card"
                                   Role="alert"
                                   Title="Showing the last available snapshot."
                                   Message="@errorMessage" />
            }

            <HealthSummary AvailableServiceCount="@AvailableServiceCount"
                           ServiceCount="@ServiceCount"
                           HealthyNodeCount="@HealthyNodeCount"
                           NodeCount="@NodeCount"
                           ResourceIssueCount="@ResourceIssueCount"
                           DependencyIssueCount="@DependencyIssueCount" />

            if (UnmonitoredDependencyCount > 0) {
                <section class="card system-health-warning"
                         role="status">
                    <strong>
                        @FormatUnmonitoredDependencyCount(UnmonitoredDependencyCount)
                    </strong>

                    <p>
                        Dependencies with unknown health are shown separately
                        from observed operational failures.
                    </p>
                </section>
            }

            <div class="system-health-groups">
                @foreach (TopologyGroupDefinition group in Definition.Groups) {
                    GroupSnapshots.TryGetValue(group.Id, out TopologyGroupSnapshot? groupSnapshot);

                    <GroupHealthCard Definition="@group"
                                     Snapshot="@groupSnapshot"
                                     NodeDefinitions="@NodeDefinitions"
                                     NodeSnapshots="@NodeSnapshots"
                                     OutgoingEdgeDefinitions="@OutgoingEdgeDefinitions"
                                     EdgeSnapshots="@EdgeSnapshots" />
                }
            </div>
        }
    </section>
</section>

@code {
    /// <summary>
    /// Stores the most recently loaded system topology snapshot.
    /// </summary>
    private TopologySnapshot? snapshot;

    /// <summary>
    /// Stores the user-facing message for the most recent refresh failure.
    /// </summary>
    private string? errorMessage;

    /// <summary>
    /// Indicates whether a health snapshot refresh is currently running.
    /// </summary>
    private bool isLoading;

    /// <summary>
    /// Gets the static topology definition used to interpret snapshots.
    /// </summary>
    private TopologyDefinition Definition =>
        TopologyProvider.Definition;

    /// <summary>
    /// Gets or sets topology node definitions indexed by node identifier.
    /// </summary>
    private IReadOnlyDictionary<string, TopologyNodeDefinition>
        NodeDefinitions { get; set; } =
            new Dictionary<string, TopologyNodeDefinition>(
                StringComparer.Ordinal);

    /// <summary>
    /// Gets or sets node observations indexed by node identifier.
    /// </summary>
    private IReadOnlyDictionary<string, TopologyNodeSnapshot>
        NodeSnapshots { get; set; } =
            new Dictionary<string, TopologyNodeSnapshot>(
                StringComparer.Ordinal);

    /// <summary>
    /// Gets or sets group observations indexed by group identifier.
    /// </summary>
    private IReadOnlyDictionary<string, TopologyGroupSnapshot>
        GroupSnapshots { get; set; } =
            new Dictionary<string, TopologyGroupSnapshot>(
                StringComparer.Ordinal);

    /// <summary>
    /// Gets or sets dependency observations indexed by source and target node.
    /// </summary>
    private IReadOnlyDictionary<
        (string SourceNodeId, string TargetNodeId),
        TopologyEdgeSnapshot> EdgeSnapshots { get; set; } =
            new Dictionary<
                (string SourceNodeId, string TargetNodeId),
                TopologyEdgeSnapshot>();

    /// <summary>
    /// Gets or sets outgoing dependency definitions grouped by source node.
    /// </summary>
    private ILookup<string, TopologyEdgeDefinition>
        OutgoingEdgeDefinitions { get; set; } =
            Array.Empty<TopologyEdgeDefinition>()
                .ToLookup(
                    static edge => edge.SourceNodeId,
                    StringComparer.Ordinal);

    /// <summary>
    /// Gets or sets the identifiers of topology nodes that represent services.
    /// </summary>
    private IReadOnlySet<string> ServiceNodeIds { get; set; } =
        new HashSet<string>(StringComparer.Ordinal);

    /// <summary>
    /// Gets the number of service nodes in the topology definition.
    /// </summary>
    private int ServiceCount =>
        ServiceNodeIds.Count;

    /// <summary>
    /// Gets the total number of nodes in the topology definition.
    /// </summary>
    private int NodeCount =>
        Definition.Nodes.Count;

    /// <summary>
    /// Gets the number of observed service nodes that are available.
    /// </summary>
    private int AvailableServiceCount =>
        NodeSnapshots.Values.Count(
            node =>
                ServiceNodeIds.Contains(node.Id) &&
                node.Availability == ResourceAvailability.Available);

    /// <summary>
    /// Gets the number of observed nodes that are healthy.
    /// </summary>
    private int HealthyNodeCount =>
        NodeSnapshots.Values.Count(
            static node => node.Health == HealthStatus.Healthy);

    /// <summary>
    /// Gets the number of unavailable, degraded, or unhealthy resources.
    /// </summary>
    private int ResourceIssueCount =>
        NodeSnapshots.Values.Count(
            static node =>
                node.Availability == ResourceAvailability.Unavailable ||
                node.Health is
                    HealthStatus.Degraded or
                    HealthStatus.Unhealthy);

    /// <summary>
    /// Gets the number of degraded or unhealthy observed dependencies.
    /// </summary>
    private int DependencyIssueCount =>
        EdgeSnapshots.Values.Count(
            static edge => edge.Health is
                HealthStatus.Degraded or
                HealthStatus.Unhealthy);

    /// <summary>
    /// Gets the number of dependencies whose health is unknown.
    /// </summary>
    private int UnmonitoredDependencyCount =>
        EdgeSnapshots.Values.Count(
            static edge => edge.Health == HealthStatus.Unknown);

    /// <inheritdoc />
    protected override async Task OnInitializedAsync() {
        BuildDefinitionIndexes();
        await RefreshAsync();
    }

    /// <summary>
    /// Builds lookup structures from the static topology definition.
    /// </summary>
    private void BuildDefinitionIndexes() {
        NodeDefinitions = Definition.Nodes.ToDictionary(
            static node => node.Id,
            StringComparer.Ordinal);

        ServiceNodeIds = Definition.Nodes
            .Where(static node => node.Kind == TopologyNodeKind.Service)
            .Select(static node => node.Id)
            .ToHashSet(StringComparer.Ordinal);

        OutgoingEdgeDefinitions = Definition.Edges.ToLookup(
            static edge => edge.SourceNodeId,
            StringComparer.Ordinal);
    }

    /// <summary>
    /// Loads the latest system health snapshot unless a refresh is already
    /// running.
    /// </summary>
    /// <returns>A task that represents the asynchronous refresh operation.</returns>
    private async Task RefreshAsync() {
        if (isLoading) {
            return;
        }

        isLoading = true;
        errorMessage = null;

        try {
            TopologySnapshot latestSnapshot =
                await HealthService.GetSnapshotAsync();

            snapshot = latestSnapshot;
            BuildSnapshotIndexes(latestSnapshot);
        } catch (OperationCanceledException) {
            errorMessage =
                "The health refresh was canceled.";
        } catch (Exception) {
            errorMessage =
                "The latest system health snapshot could not be loaded.";
        } finally {
            isLoading = false;
        }
    }

    /// <summary>
    /// Builds lookup structures from a newly loaded topology snapshot.
    /// </summary>
    /// <param name="latestSnapshot">The snapshot to index.</param>
    private void BuildSnapshotIndexes(
        TopologySnapshot latestSnapshot) {
        NodeSnapshots = latestSnapshot.Nodes.ToDictionary(
            static node => node.Id,
            StringComparer.Ordinal);

        GroupSnapshots = latestSnapshot.Groups.ToDictionary(
            static group => group.Id,
            StringComparer.Ordinal);

        EdgeSnapshots = latestSnapshot.Edges.ToDictionary(
            static edge => (
                edge.SourceNodeId,
                edge.TargetNodeId));
    }

    /// <summary>
    /// Formats the number of dependencies whose health is unknown.
    /// </summary>
    /// <param name="count">The number of unmonitored dependencies.</param>
    /// <returns>A grammatically appropriate status message.</returns>
    private static string FormatUnmonitoredDependencyCount(
        int count) {
        return count == 1
            ? "1 dependency is not currently monitored."
            : $"{count} dependencies are not currently monitored.";
    }

    /// <summary>
    /// Formats a timestamp as local time for compact display.
    /// </summary>
    /// <param name="value">The timestamp to format.</param>
    /// <returns>The local time in hours, minutes, and seconds.</returns>
    private static string FormatTime(
        DateTimeOffset value) {
        return value
            .ToLocalTime()
            .ToString("HH:mm:ss");
    }

    /// <summary>
    /// Formats a timestamp as a complete local date and time.
    /// </summary>
    /// <param name="value">The timestamp to format.</param>
    /// <returns>The local date, time, and UTC offset.</returns>
    private static string FormatFullTimestamp(
        DateTimeOffset value) {
        return value
            .ToLocalTime()
            .ToString("yyyy-MM-dd HH:mm:ss zzz");
    }
}
