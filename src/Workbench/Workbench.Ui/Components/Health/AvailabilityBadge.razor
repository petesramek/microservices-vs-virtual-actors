@using global::Observability.Topology.Snapshots

<span class="availability-badge @Presentation.CssClass"
      role="status"
      aria-label="Availability: @Presentation.Label"
      title="@Presentation.Label">
    <span class="availability-indicator" aria-hidden="true"></span>
    <span class="availability-text">@Presentation.Label</span>
</span>

@code {
    /// <summary>
    /// Gets or sets the resource availability displayed by the badge.
    /// </summary>
    [Parameter]
    public ResourceAvailability Value { get; set; }

    private AvailabilityPresentation Presentation => Value switch
    {
        ResourceAvailability.Available => new(
            "availability-badge--available",
            "Available"),

        ResourceAvailability.Unavailable => new(
            "availability-badge--unavailable",
            "Unavailable"),

        ResourceAvailability.Unknown => new(
            "availability-badge--unknown",
            "Unknown"),

        _ => new(
            "availability-badge--unknown",
            "Unknown")
    };

    private readonly record struct AvailabilityPresentation(
        string CssClass,
        string Label);
}
