@using global::Observability.Health
@using global::Observability.Topology.Definitions
@using global::Observability.Topology.Snapshots

<section class="card system-health-group"
         data-group-id="@Definition.Id"
         aria-labelledby="@HeadingId">
    <header class="system-health-group-header">
        <h3 id="@HeadingId">
            @Definition.DisplayName
        </h3>

        <HealthStatusBadge Status="@GroupHealth" />
    </header>

    @if (Definition.NodeIds.Count == 0)
    {
        <p class="system-health-group-empty">
            No resources are configured for this group.
        </p>
    }
    else
    {
        <div class="system-health-group-nodes">
            @foreach (string nodeId in Definition.NodeIds)
            {
                if (NodeDefinitions.TryGetValue(
                        nodeId,
                        out TopologyNodeDefinition? nodeDefinition))
                {
                    NodeSnapshots.TryGetValue(
                        nodeId,
                        out TopologyNodeSnapshot? nodeSnapshot);

                    <NodeHealthCard
                        Definition="@nodeDefinition"
                        Snapshot="@nodeSnapshot"
                        OutgoingEdges="@GetOutgoingEdges(nodeId)"
                        EdgeSnapshots="@EdgeSnapshots"
                        NodeDefinitions="@NodeDefinitions" />
                }
                else
                {
                    <article class="system-health-node system-health-node-missing"
                             data-node-id="@nodeId"
                             role="status">
                        <header class="system-health-node-header">
                            <div class="system-health-node-title">
                                <span class="system-health-node-kind">
                                    Unknown resource
                                </span>

                                <strong>@nodeId</strong>
                            </div>

                            <HealthStatusBadge
                                Status="@HealthStatus.Unknown" />
                        </header>

                        <p class="system-health-node-description">
                            The group references a node that is not present
                            in the topology definition.
                        </p>
                    </article>
                }
            }
        </div>
    }
</section>

@code {
    /// <summary>
    /// Gets or sets the topology definition for the health group rendered by
    /// this component.
    /// </summary>
    /// <value>
    /// The static group definition containing the stable identifier, display
    /// name, and ordered node identifiers.
    /// </value>
    [Parameter]
    public required TopologyGroupDefinition Definition { get; set; }

    /// <summary>
    /// Gets or sets the latest health snapshot for the group.
    /// </summary>
    /// <value>
    /// The current group snapshot, or <see langword="null"/> when no snapshot
    /// is available.
    /// </value>
    [Parameter]
    public TopologyGroupSnapshot? Snapshot { get; set; }

    /// <summary>
    /// Gets or sets the topology node definitions indexed by stable node
    /// identifier.
    /// </summary>
    /// <value>
    /// A read-only lookup used to resolve every node referenced by the group.
    /// </value>
    [Parameter]
    public required IReadOnlyDictionary<string, TopologyNodeDefinition>
        NodeDefinitions { get; set; }

    /// <summary>
    /// Gets or sets the latest topology node snapshots indexed by stable node
    /// identifier.
    /// </summary>
    /// <value>
    /// A read-only lookup of current node snapshots. A referenced node may be
    /// absent when no snapshot has been collected.
    /// </value>
    [Parameter]
    public required IReadOnlyDictionary<string, TopologyNodeSnapshot>
        NodeSnapshots { get; set; }

    /// <summary>
    /// Gets or sets the edge definitions grouped by source-node identifier.
    /// </summary>
    /// <value>
    /// A lookup used to resolve the outgoing topology edges for each rendered
    /// node.
    /// </value>
    [Parameter]
    public required ILookup<string, TopologyEdgeDefinition>
        OutgoingEdgeDefinitions { get; set; }

    /// <summary>
    /// Gets or sets the latest edge snapshots indexed by source and target node
    /// identifiers.
    /// </summary>
    /// <value>
    /// A read-only lookup used by child node components to resolve dependency
    /// health.
    /// </value>
    [Parameter]
    public required IReadOnlyDictionary<
        (string SourceNodeId, string TargetNodeId),
        TopologyEdgeSnapshot> EdgeSnapshots { get; set; }

    /// <summary>
    /// Gets the stable HTML identifier used to associate the group heading with
    /// its containing section.
    /// </summary>
    /// <value>
    /// An HTML-safe identifier derived from the group definition identifier.
    /// </value>
    private string HeadingId =>
        $"system-health-group-{SanitizeHtmlId(Definition.Id)}";

    /// <summary>
    /// Gets the health status displayed for the group.
    /// </summary>
    /// <value>
    /// The status from the latest group snapshot, or
    /// <see cref="HealthStatus.Unknown"/> when no snapshot is available.
    /// </value>
    private HealthStatus GroupHealth =>
        Snapshot?.Health ?? HealthStatus.Unknown;

    /// <summary>
    /// Gets the outgoing edge definitions for a topology node.
    /// </summary>
    /// <param name="nodeId">
    /// The stable identifier of the source node whose edges are requested.
    /// </param>
    /// <returns>
    /// A read-only materialized list of edges originating from the node. The
    /// list is empty when the lookup contains no matching edges.
    /// </returns>
    private IReadOnlyList<TopologyEdgeDefinition> GetOutgoingEdges(
        string nodeId)
    {
        return OutgoingEdgeDefinitions[nodeId].ToArray();
    }

    /// <summary>
    /// Converts an arbitrary value into a stable fragment suitable for use in
    /// an HTML <c>id</c> attribute.
    /// </summary>
    /// <param name="value">The value to sanitize.</param>
    /// <returns>
    /// The sanitized value, with unsupported characters replaced by hyphens;
    /// or <c>unknown</c> when <paramref name="value"/> is null, empty, or
    /// whitespace.
    /// </returns>
    private static string SanitizeHtmlId(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "unknown";
        }

        return string.Concat(
            value.Select(character =>
                char.IsLetterOrDigit(character) ||
                character is '-' or '_'
                    ? character
                    : '-'));
    }
}
