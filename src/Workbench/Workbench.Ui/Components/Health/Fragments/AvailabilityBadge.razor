@using global::Observability.Topology.Snapshots

<span class="availability-badge @Presentation.CssClass"
      aria-label="Availability: @Presentation.Label"
      title="@Presentation.Description">
    <span class="availability-indicator" aria-hidden="true"></span>
    <span class="availability-text">@Presentation.Label</span>
</span>

@code {
    /// <summary>
    /// Defines the visual presentation used for an available resource.
    /// </summary>
    private static readonly AvailabilityPresentation AvailablePresentation =
        new(
            "availability-available",
            "Online",
            "The service is reachable.");

    /// <summary>
    /// Defines the visual presentation used for an unavailable resource.
    /// </summary>
    private static readonly AvailabilityPresentation UnavailablePresentation =
        new(
            "availability-unavailable",
            "Down",
            "The service is not reachable.");

    /// <summary>
    /// Defines the visual presentation used when no current availability
    /// observation exists.
    /// </summary>
    private static readonly AvailabilityPresentation UnknownPresentation =
        new(
            "availability-unknown",
            "Unknown",
            "No current availability observation is available.");

    /// <summary>
    /// Gets or sets the resource availability displayed by the badge.
    /// </summary>
    /// <value>The availability state to present.</value>
    [Parameter]
    public ResourceAvailability Value { get; set; }

    /// <summary>
    /// Gets the visual presentation associated with the current availability
    /// value.
    /// </summary>
    /// <value>
    /// The matching presentation, or the unknown presentation when
    /// <see cref="Value"/> contains an unsupported value.
    /// </value>
    private AvailabilityPresentation Presentation => Value switch
    {
        ResourceAvailability.Available => AvailablePresentation,
        ResourceAvailability.Unavailable => UnavailablePresentation,
        ResourceAvailability.Unknown => UnknownPresentation,
        _ => UnknownPresentation,
    };

    /// <summary>
    /// Represents the CSS class and accessible text used to display an
    /// availability state.
    /// </summary>
    /// <param name="CssClass">
    /// The CSS class that applies the state-specific badge styling.
    /// </param>
    /// <param name="Label">
    /// The concise availability label displayed by the badge.
    /// </param>
    /// <param name="Description">
    /// The explanatory availability text exposed as the badge tooltip.
    /// </param>
    private readonly record struct AvailabilityPresentation(
        string CssClass,
        string Label,
        string Description);
}
